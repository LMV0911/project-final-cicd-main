# Local development defaults. Copy to .env only if you need to override them.
# Do not use these values for production.

APP_ENV=development
NODE_ENV=development
JWT_SECRET=dev_jwt_secret_change_me
CORS_ORIGIN=http://localhost:8080

AUTH_SERVICE_URL=http://auth-service:3001
PRODUCT_SERVICE_URL=http://product-service:3000
ORDER_SERVICE_URL=http://order-service:3002

AUTH_MONGODB_URI=mongodb://mongodb:27017/auth
PRODUCT_MONGODB_URI=mongodb://mongodb:27017/products
ORDER_MONGODB_URI=mongodb://mongodb:27017/orders

# Used by docker-compose.prod.yml / GitLab deployment.
CI_REGISTRY_IMAGE=registry.gitlab.com/group/project
IMAGE_TAG=latest

DEV_FRONTEND_PORT=8082
DEV_CORS_ORIGIN=http://localhost:8082
DEV_JWT_SECRET=dev_jwt_secret_change_me

STAGING_FRONTEND_PORT=8081
STAGING_CORS_ORIGIN=http://localhost:8081
STAGING_JWT_SECRET=staging_jwt_secret_change_me
